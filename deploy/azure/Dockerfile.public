FROM python:3.12.15-slim-bookworm@sha256:57d96f71de145a98e7ceca18ee4ade77bba4103a33a72dfaea026b23625c6bf0 AS build
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_PROJECT_ENVIRONMENT=/opt/venv
WORKDIR /app/candidate
COPY pyproject.toml uv.lock .gitlab-ci.yml LICENSE ./
RUN pip install --no-cache-dir uv==0.11.16 \
    && uv sync --frozen --extra dev --extra public --no-install-project --python /usr/local/bin/python
COPY src/ src/
COPY tests/ tests/
COPY scripts/evaluate_scenarios.py scripts/evaluate_scenarios.py
COPY .gitlab/duo/flows/release-risk.yaml .gitlab/duo/flows/release-risk.yaml
COPY frontend/ frontend/
COPY docs/phase4/ docs/phase4/
COPY deploy/azure/build_public_payload.py /build_public_payload.py
ARG SOURCE_SHA
RUN python frontend/build_console.py --output-dir /app/reference-site \
    && python frontend/build_public_console.py --output-dir /app/site \
    && python /build_public_payload.py --root /app/candidate --sha "$SOURCE_SHA" --output /app/source-manifest.json

FROM python:3.12.15-slim-bookworm@sha256:57d96f71de145a98e7ceca18ee4ade77bba4103a33a72dfaea026b23625c6bf0
ARG SOURCE_SHA
LABEL org.opencontainers.image.title="ReleaseGate public fixed-scenario verification" \
      org.opencontainers.image.source="https://github.com/miku-wwl/agentic-release-gate" \
      org.opencontainers.image.revision="${SOURCE_SHA}" \
      org.opencontainers.image.licenses="MIT" \
      com.releasegate.deployment-mode="PUBLIC_FIXED_SCENARIO_VERIFICATION"
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/candidate/src \
    PATH=/opt/venv/bin:/usr/local/bin:/usr/bin:/bin PUBLIC_LIVE_ACCEPTED=0 PUBLIC_EXECUTION_MODE=STAGING
# Project-specific UID avoids per-real-UID RLIMIT_NPROC accounting collisions
# with unrelated workloads using the common UID 10001 on the same kernel.
RUN printf 'releasegate:x:43343:\n' >> /etc/group \
    && printf 'releasegate:x:43343:43343:ReleaseGate:/nonexistent:/usr/sbin/nologin\n' >> /etc/passwd
COPY --from=build /opt/venv /opt/venv
COPY --from=build /app/candidate /app/candidate
COPY --from=build /app/site /app/site
COPY --from=build /app/reference-site /app/reference-site
COPY --from=build /app/source-manifest.json /app/source-manifest.json
COPY deploy/azure/public_gunicorn.py /app/gunicorn.conf.py
COPY deploy/azure/hosted_acceptance.py /app/qa/hosted_acceptance.py
USER 43343:43343
WORKDIR /app/candidate
RUN PUBLIC_ORIGIN=http://127.0.0.1:8080 PUBLIC_EXECUTION_MODE=LOCKED gunicorn --check-config --config /app/gunicorn.conf.py 'releasegate.public_verification:create_app()'
EXPOSE 8080
CMD ["python", "-m", "releasegate.public_bootstrap"]
